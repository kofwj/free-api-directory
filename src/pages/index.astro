---
import Layout from '../layouts/Layout.astro';
import data from '../data/apis.json';
const total = data.categories.reduce((n, c) => n + c.items.length, 0);
---
<Layout title="免费 API 目录 — 额度、绑卡、国内直连一次讲清" description="免费大模型、天气、股票、地图、IP 快递 API 对比：免费额度、要不要 Key、绑卡、国内直连、能不能商用。">
<section class="hero">
<h1>免费 API，<em>先看额度再动手</em></h1>
<p>8 类，{total} 个 API。</p>
</section>
<div class="grid">
{data.categories.map(c => (
  <a class="card" href={`/${c.slug}/`}>
    <span class="tag">{c.items.length} 个 API</span>
    <h3>{c.title}</h3>
    <ul style="margin:10px 0 0;padding-left:18px;color:#475569;font-size:14px;line-height:1.9">
    {c.items.slice(0,3).map(i => (<li>{i.name} — {i.quota}</li>))}
    </ul>
    <div class="go">看完整对比 →</div>
  </a>
))}
</div>
<h2>横评文章</h2>
<div class="grid">
<a class="card" href="/guides/weather/"><h3>免费天气 API 对比：额度谁最大</h3><p>Open-Meteo 免 Key 10,000 次/天，OpenWeatherMap 经典档 1,000,000 次/月，谁更适合你。</p><div class="go">读横评 →</div></a>
<a class="card" href="/guides/llm/"><h3>免费大模型 API 国内直连横评</h3><p>DeepSeek、智谱、豆包、通义国内能用；Gemini、Groq、OpenAI 需境外网络。</p><div class="go">读横评 →</div></a>
</div>
</Layout>
