---
import Layout from '../layouts/Layout.astro';
import data from '../data/apis.json';
export function getStaticPaths() {
  return data.categories.map(c => ({ params: { slug: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const badge = (v: string) => {
  if (v.includes('免 Key')) return ['green', v];
  if (v.includes('要 Key') || v.includes('要 Token')) return ['amber', v];
  if (v.startsWith('是')) return ['green', v];
  if (v.startsWith('否')) return ['amber', v];
  if (v.includes('不用绑卡')) return ['green', v];
  if (v.includes('要注册')) return ['grey', v];
  return ['grey', v];
};
---
<Layout title={`${cat.title} — 免费额度对比`} description={`${cat.title}对比：免费额度、Key、绑卡、国内直连、商用。`}>
<p class="back"><a href="/">← 回首页</a></p>
<h1 style="font-size:32px;margin:8px 0">{cat.title}</h1>
<p class="section-note">共 {cat.items.length} 个 API</p>
<div class="table-wrap"><table>
<thead><tr><th>API</th><th>免费额度</th><th>Key</th><th>绑卡</th><th>国内直连</th><th>商用</th><th>来源</th></tr></thead>
<tbody>
{cat.items.map(i => (
<tr>
<td><a href={`/api/${i.slug}/`}><strong>{i.name}</strong></a></td>
<td>{i.quota}</td>
<td><span class={`badge ${badge(i.key)[0]}`}>{badge(i.key)[1]}</span></td>
<td><span class={`badge ${badge(i.card)[0]}`}>{badge(i.card)[1]}</span></td>
<td><span class={`badge ${badge(i.china_direct)[0]}`}>{badge(i.china_direct)[1]}</span></td>
<td>{i.commercial}</td>
<td style="color:#64748b;font-size:13px">{i.source}</td>
</tr>
))}
</tbody>
</table></div>
</Layout>
